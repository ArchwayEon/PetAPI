@{
    ViewData["Title"] = "Pets (AJAX)";
}

<h1>Pets</h1>
<p class="text-muted">This page calls the Pet Web API at <code>/api/pets</code> with <code>fetch()</code> through the <code>PetRepository</code> JavaScript class.</p>

<div id="errorAlert" class="alert alert-danger d-none" role="alert"></div>

<div class="row">
    <div class="col-md-7">
        <table id="petTable" class="table table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Weight</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <tr><td colspan="4">Loading...</td></tr>
            </tbody>
        </table>
    </div>

    <div class="col-md-5">
        <div class="card mb-3">
            <div class="card-header">Add a Pet</div>
            <div class="card-body">
                <form id="createPetForm">
                    <div class="mb-2">
                        <label for="createName" class="form-label">Name</label>
                        <input id="createName" name="Name" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label for="createWeight" class="form-label">Weight</label>
                        <input id="createWeight" name="Weight" type="number" step="0.1" min="0" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-primary">Create</button>
                </form>
            </div>
        </div>

        <div id="detailsCard" class="card d-none">
            <div class="card-header">Pet Details</div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-4">Id</dt><dd class="col-8" id="detailId"></dd>
                    <dt class="col-4">Name</dt><dd class="col-8" id="detailName"></dd>
                    <dt class="col-4">Weight</dt><dd class="col-8" id="detailWeight"></dd>
                </dl>
                <h6>Edit</h6>
                <form id="editPetForm">
                    <input type="hidden" name="Id" />
                    <div class="mb-2">
                        <label for="editName" class="form-label">Name</label>
                        <input id="editName" name="Name" class="form-control" required />
                    </div>
                    <div class="mb-2">
                        <label for="editWeight" class="form-label">Weight</label>
                        <input id="editWeight" name="Weight" type="number" step="0.1" min="0" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-success">Save</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/pets.js" asp-append-version="true"></script>
}
